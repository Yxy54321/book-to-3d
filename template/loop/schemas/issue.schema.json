{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backlog issue",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "scene",
    "pillar",
    "severity",
    "status",
    "source",
    "evidence",
    "attempts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^I-[0-9]{4,}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "enum": [
        "experiential",
        "technical",
        "factual",
        "design",
        "ethics",
        "art"
      ]
    },
    "scene": {
      "type": "string"
    },
    "beat": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pillar": {
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8",
        "E9",
        "E10"
      ]
    },
    "severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "stuck",
        "wontfix_by_design",
        "stalled_carryover"
      ]
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "lens 名 / human / probe / canary / playtest"
    },
    "recurring": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "locator"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "description": "区域描述 / 日志行 / 文档章节 / 原书页码"
          }
        }
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}