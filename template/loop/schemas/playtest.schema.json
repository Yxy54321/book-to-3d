                  "type": "boolean"
                }
              },
              "required": [
                "answer",
                "prior_knowledge"
              ]
            }
          }
        },
        "present_moment": {
          "type": "string"
        },
        "reading_moment": {
          "type": "string"
        },
        "wanted_but_couldnt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confusion_or_boredom": {
          "type": "array",
