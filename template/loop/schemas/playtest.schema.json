                },
                "cites_own_experience": {
                  "type": "string"
                },
                "prior_knowledge": {
                  "type": "boolean"
                }
              },
              "required": [
                "answer",
                "prior_knowledge"
              ]
            },
            "LO4": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "cites_own_experience": {
                  "type": "string"
                },
                "prior_knowledge": {
                  "type": "boolean"
                }
              },
              "required": [
                "answer",
                "prior_knowledge"
              ]
            },
            "LO5": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "cites_own_experience": {
                  "type": "string"
                },
                "prior_knowledge": {
                  "type": "boolean"
                }
              },
              "required": [
                "answer",
