                  "type": "string"
                },
                "prior_knowledge": {
                  "type": "boolean"
                }
              },
              "required": [
                "answer",
                "prior_knowledge"
              ]
            },
            "LO2": {
              "type": "object",
              "properties": {
                "answer": {
