{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quotes",
  "type": "object",
  "required": [
    "quotes"
  ],
  "properties": {
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "segments",
          "page",
          "speaker",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "逐字原文；被插语（如 he asked）或省略号隔开的部分分段记录"
          },
          "page": {
            "type": "string",
            "description": "PDF 页码，跨页写 21-22"
          },
          "speaker": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "book",
              "research"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "translation_zh": {
            "type": "string"
          },
          "used_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}