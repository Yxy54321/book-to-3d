{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "description": "R2 每个评审视角的输出",
  "type": "object",
  "required": [
    "lens",
    "scope",
    "issues"
  ],
  "properties": {
    "lens": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "description": "可选：支柱或关键镜头评分 1-5",
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 5
      }
    },
    "must_answer": {
      "type": "object",
      "description": "RUBRICS 3.x 必答问题的回答",
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "type",
          "scene",
          "pillar",
          "severity",
          "confidence",
          "evidence",
          "observation",
          "why_it_matters"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "experiential",
              "technical",
              "factual",
              "design",
              "ethics",
              "art"
            ]
          },
          "scene": {
            "type": "string"
          },
          "beat": {
            "type": "string"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pillar": {
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7",
              "E8",
              "E9",
              "E10"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file",
                "locator"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "locator": {
                  "type": "string",
                  "description": "区域描述 / 日志行 / 文档章节 / 原书页码"
                }
              }
            }
          },
          "observation": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "removal_option": {
            "type": "string",
            "description": "如果能通过去掉某物来解决，写在这里"
          }
        }
      }
    }
  }
}