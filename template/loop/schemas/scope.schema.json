{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scope",
  "type": "object",
  "required": [
    "round",
    "phase",
    "theme",
    "target_issues",
    "hypothesis",
    "allowed_paths",
    "protected",
    "checks",
    "candidates"
  ],
  "properties": {
    "round": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "escalation": {
      "enum": [
        null,
        "switch_topic",
        "divergent",
        "fresh_eyes"
      ]
    },
    "target_issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "change",
        "expected_evidence"
      ],
      "properties": {
        "change": {
          "type": "string"
        },
        "expected_evidence": {
          "type": "string",
          "description": "哪条证据会怎样变化"
        }
      }
    },
    "differs_from_previous_attempts": {
      "type": "string",
      "description": "该 issue 已被拒绝过时必填"
    },
    "lessons_consulted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_change": {
      "type": "boolean",
      "default": false
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "automated",
        "judged_by"
      ],
      "properties": {
        "automated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "judged_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "playtests": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "enum": [
        1,
        2
      ]
    }
  }
}